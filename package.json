{
  "name": "jmborrill-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && node scripts/check-site.mjs",
    "serve": "node scripts/serve.mjs",
    "demo:aiws": "node demos/aiws/gateway.mjs",
    "seed:aiws": "node demos/aiws/make-seed.mjs",
    "test:demo": "node --test demos/aiws/gateway.test.mjs",
    "e2e": "playwright test",
    "demo:qrs": "$QRS_DIR/.venv/bin/python demos/qrs/server.py",
    "test:qrs": "node --test demos/qrs/server.test.mjs",
    "check:qrs-network": "demos/qrs/check-network.sh"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@axe-core/playwright": {
      "playwright-core": "1.63.0"
    }
  }
}
